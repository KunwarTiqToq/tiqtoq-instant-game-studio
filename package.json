{
  "name": "tiqtoq-instant-game-server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Database-free authoritative server for the tiQtoQ instant game demos",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.mjs",
    "dev": "node --env-file-if-exists=.env --watch src/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/check.mjs",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "ws": "^8.21.3"
  }
}
